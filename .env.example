# Copy to `.env` and fill in whichever providers you are using.
#   cp .env.example .env
#
# You need at least one. Two from DIFFERENT labs makes the result more
# interesting: a cross-lab comparison distinguishes "this is a property of
# transformers" from "this is a quirk of one lab's training recipe".

# ---------------------------------------------------------------------------
# Groq -- https://console.groq.com/keys
# Free tier. Fast. Serves Llama and Qwen. Recommended starting point.
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Mistral -- https://console.mistral.ai/api-keys
# Free experimental tier.
# ---------------------------------------------------------------------------
MISTRAL_API_KEY=

# ---------------------------------------------------------------------------
# Optional extras -- any OpenAI-compatible endpoint works.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
CEREBRAS_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Free-tier rate limits change often. The runner ships conservative defaults
# per provider; override here if your account has different limits.
# Units: requests per minute.
# ---------------------------------------------------------------------------
# LITM_RPM_GROQ=25
# LITM_RPM_MISTRAL=55

# ---------------------------------------------------------------------------
# Where the paper's data landed. Default matches scripts/download_data.py.
# ---------------------------------------------------------------------------
# LITM_DATA_ROOT=data
